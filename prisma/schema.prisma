// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum DocumentType {
  CPF
  PASSPORT
}

enum Language {
  PT
  ES
  EN
}

enum EventStatus {
  DRAFT
  REVISION
  PUBLISHED
  SUSPENDED
  CANCELLED
  COMPLETED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CRYPTO
  BOLETO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AccountType {
  USER
  ORGANIZER
}

enum UserRole {
  USER
  ORGANIZER
  PODIOGO_STAFF
  ADMIN
}

enum OrganizationMemberRole {
  OWNER
  EMPLOYEE
}

enum CouponType {
  DISCOUNT
  QUANTITY
  AGE
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CpfListStatus {
  DISABLED
  ENABLED
}

enum VoucherStatus {
  ACTIVE
  USED
  EXPIRED
  INACTIVE
}

/**
 * Central de comunicação — envios por evento (painel organizador)
 */
enum EventNotificationStatus {
  review
  sent
  denied
}

enum WithdrawalStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// Origem do registro de atividade do usuário.
/// FRONTEND  → telemetria enviada pelo cliente (cliques, page-view, scroll, etc.).
/// BACKEND   → captura automática via interceptor em rotas sensíveis.
/// WEBHOOK   → eventos vindos de provedores externos (Cielo, etc.).
enum UserActivitySource {
  FRONTEND
  BACKEND
  WEBHOOK
}

/// Categoria do evento — usada como dimensão de agregação e regra de retenção.
/// Categorias de auditoria (AUTH/CHECKOUT/COMPLIANCE) têm retenção longa (2 anos).
/// Demais (PAGE_VIEW/CLICK/API/PROFILE/OTHER) têm retenção curta (90 dias).
enum UserActivityCategory {
  PAGE_VIEW
  CLICK
  API
  AUTH
  CHECKOUT
  PROFILE
  COMPLIANCE
  OTHER
}

model User {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String
  accountType           AccountType   @default(USER) // Tipo de conta: USER (participante) ou ORGANIZER (organizador)
  password              String
  firstName             String
  lastName              String
  gender                Gender?
  genderDetails         String? // Para "outro: especificar" quando gender não cobre
  phone                 String?
  reservePhone          String?
  dateOfBirth           DateTime?
  country               String?
  state                 String?
  city                  String?
  postalCode            String? // CEP / código postal — espelhado do endereço de cobrança do pedido
  street                String? // Logradouro
  number                String? // Número
  complement            String? // Complemento
  neighborhood          String? // Bairro
  documentType          DocumentType?
  documentNumber        String? // CPF/CNPJ com formatação (ex: "123.456.789-00")
  documentNumberClean   String? // CPF/CNPJ sem formatação (ex: "12345678900") - usado para validação de unicidade
  acceptedTerms         Boolean       @default(false)
  acceptedPrivacyPolicy Boolean       @default(false)
  receiveCalendarEvents Boolean       @default(false)
  receivePartnerPromos  Boolean       @default(false)
  language              Language      @default(PT)
  isActive              Boolean       @default(true)
  role                  UserRole      @default(USER)
  avatarUrl             String?
  googleId              String?
  googleEmail           String?
  totpSecret            String? // Secret TOTP para 2FA
  mfaEnabled            Boolean       @default(false) // Se 2FA está habilitado
  lastLoginAt           DateTime? // Último login (email/senha ou fluxo que chama login())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Relations
  registrations             Registration[]             @relation("Participant")
  contactMessages           ContactMessage[]
  payments                  Payment[]
  invitedRegistrations      Registration[]             @relation("InvitedBy")
  linkedUsersAsMain         LinkedUser[]               @relation("MainUser")
  organizationMembers       OrganizationMember[]
  organizationAuditLogs     OrganizationAuditLog[]
  organizerAuditPageDedupes OrganizerAuditPageDedupe[]
  orders                    Order[]
  eventNotificationsCreated EventNotification[]        @relation("EventNotificationCreator")
  withdrawals               EventWithdrawal[]
  eventAudits               EventAudit[]
  activityLogs              UserActivityLog[]

  // Índices compostos para permitir mesmo email em contas diferentes
  @@unique([email, accountType])
  @@unique([documentNumberClean, accountType])
  @@unique([googleId, accountType])
  @@index([email, accountType])
  @@index([accountType])
}

model Organization {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String // Razão social
  tradeName   String? // Nome fantasia
  document    String? @unique // CPF ou CNPJ (apenas números)
  logoUrl     String? // Foto/logo da organização
  email       String
  phone       String?
  whatsapp    String?
  siteUrl     String?
  instagram   String?
  description String?
  fiscalEmail String? // E-mail fiscal (notas fiscais, repasses, etc.)

  // Endereço
  zipCode      String? // CEP
  street       String? // Rua
  number       String? // Número
  neighborhood String? // Bairro
  city         String? // Cidade
  state        String? // Estado

  // Responsável (owner)
  ownerName     String? // Nome do responsável
  ownerDocument String? // CPF do responsável (apenas números)

  // Informações bancárias
  bankName              String? // Nome do banco
  bankCode              String? // Código do banco (ex: 001, 237)
  agency                String? // Agência
  account               String? // Conta
  accountType           String? // Tipo de conta: CORRENTE, POUPANCA
  accountHolderName     String? // Nome do titular da conta
  accountHolderDocument String? // CPF/CNPJ do titular

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          OrganizationMember[]
  events           Event[]
  contactMessages  ContactMessage[]
  auditLogs        OrganizationAuditLog[]
  auditPageDedupes OrganizerAuditPageDedupe[]
  pixKeys          OrganizationPixKey[]

  @@index([name])
  @@index([document])
  @@index([email])
  @@index([isActive])
}

model OrganizationPixKey {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String   @db.Uuid
  key                    String
  keyType                String   // CPF, CNPJ, EMAIL, PHONE, RANDOM
  isDefault              Boolean  @default(false)
  bankName               String?
  accountHolderName      String?
  accountHolderDocument  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  withdrawals  EventWithdrawal[]

  @@index([organizationId])
}

model OrganizationMember {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                 @db.Uuid
  userId         String                 @db.Uuid
  role           OrganizationMemberRole @default(EMPLOYEE)
  /// Permissões do painel (chaves canônicas do frontend). null = legado (tratar como acesso total).
  permissions    Json?
  /// Quando true, o membro só acessa os eventos em eventAccesses (mesmo que a lista esteja vazia).
  /// Quando false (padrão), lista vazia = acesso a todos os eventos da organização.
  restrictedToEvents Boolean @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization  Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventAccesses OrganizationMemberEventAccess[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
}

/// Whitelist de eventos por membro. Sem registros = acesso a todos os eventos da organização (política permissiva para colaboradores).
model OrganizationMemberEventAccess {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationMemberId String   @db.Uuid
  eventId              String   @db.Uuid
  createdAt            DateTime @default(now())

  member OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  event  Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([organizationMemberId, eventId])
  @@index([organizationMemberId])
  @@index([eventId])
}

model OrganizationAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  actorUserId    String?  @db.Uuid
  ip             String?
  action         String
  metadata       Json?
  occurredAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, action])
}

/// Último registro de page-view por (org, usuário, chave de página) para deduplicar acessos (ex.: F5).
model OrganizerAuditPageDedupe {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  actorUserId    String   @db.Uuid
  pageKey        String
  lastRecordedAt DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([organizationId, actorUserId, pageKey])
  @@index([organizationId, lastRecordedAt])
}

model Event {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String      @db.Uuid
  name                  String
  slug                  String?     @unique
  description           String?
  bannerUrl             String?
  logoUrl               String?
  location              String
  city                  String
  state                 String
  country               String
  zipCode               String? // CEP
  neighborhood          String? // Bairro
  googleMapsLink        String?
  contactEmail          String?  @map("contact_email")
  instagram             String?
  facebook              String?
  youtube               String?
  tiktok                String?
  website               String?
  regulationUrl         String? // URL do PDF do regulamento
  eventDate             DateTime
  registrationStartDate DateTime
  registrationEndDate   DateTime
  status                EventStatus @default(DRAFT)
  /// Opções avançadas de exibição de imagens do kit na escolha de ingressos (camelCase no JSON).
  kitSelectionDisplay   Json?       @map("kit_selection_display")
  /// Meta Pixel (Facebook/Instagram). Não expor em rotas públicas sem decisão explícita de produto.
  metaPixelId           String?     @map("meta_pixel_id")
  googleAnalyticsId     String?     @map("google_analytics_id")
  googleAdsId           String?     @map("google_ads_id")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  /// Percentual retido até a auditoria pós-evento (ex: 0.10 = 10%)
  retentionRate      Float       @default(0.10)

  /// Percentual da taxa absorvido pelo organizador (0.0–100.0). Substitui o antigo `organizerFeeRate` (escala 0-1).
  organizerFeePercent         Float     @default(0.0)
  /// Percentual da taxa repassado ao participante (0.0–100.0).
  participantFeePercent       Float     @default(0.0)
  /// Número máximo de parcelas sem juros no cartão de crédito (1, 2 ou 3).
  maxInstallments             Int       @default(1)
  /// Preenchido ao publicar o evento. Após essa data as configurações financeiras ficam bloqueadas.
  financialSettingsLockedAt   DateTime?

  organization       Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  topics             EventTopic[]
  modalities         Modality[]
  kits               Kit[]
  registrations      Registration[]
  orders             Order[]
  questions          Question[]
  locations          EventLocation[]
  ContactMessage     ContactMessage[]
  modalityGroups     ModalityGroup[]
  coupons            Coupon[]
  ticketCategories   TicketCategory[]
  tickets            Ticket[]
  products           Product[]
  // slug já tem índice automático via @unique, não precisa de índice explícito
  vouchers           Voucher[]
  memberAccessGrants OrganizationMemberEventAccess[]
  eventNotifications EventNotification[]
  withdrawals        EventWithdrawal[]
  audit              EventAudit?

  @@index([status, eventDate]) // Para buscar eventos publicados futuros
  @@index([status, country, state, city]) // Para filtros de localização (status primeiro para melhor seletividade)
  @@index([organizationId, createdAt]) // Para listar eventos da organização
  @@index([eventDate]) // Para ordenação e filtros por data
}

model EventNotification {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String                  @db.Uuid
  title       String
  messageHtml String                  @db.Text
  channels    String[]
  status      EventNotificationStatus @default(review)
  deniedReason String?                @db.Text
  /**
   * Data/hora exibida na lista (v1 = criação do registro; futuro: pode atualizar ao enviar)
   */
  occurredAt  DateTime                @default(now())
  createdById String?                 @db.Uuid
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User? @relation("EventNotificationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([eventId, occurredAt])
  @@index([eventId, status, occurredAt])
}

model EventTopic {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String   @db.Uuid
  title      String
  content    String
  isEnabled  Boolean  @default(true)
  isDefault  Boolean  @default(false) // Tópicos padrão: Descrição, Kit, Premiação, Regulamento
  /// Ex.: descrição principal obrigatória no painel (não confundir com validação de formulário).
  isRequired Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventLocation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String   @db.Uuid
  name           String?
  address        String
  city           String
  state          String
  country        String
  zipCode        String?
  neighborhood   String? // Bairro
  googleMapsLink String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model ModalityTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique // código único da modalidade (ex: "corrida-de-rua")
  label     String // nome exibido (ex: "Corrida de rua")
  icon      String? // caminho do ícone
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modalities Modality[]

  @@index([code])
  @@index([isActive])
}

model ModalityGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @db.Uuid
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  modalities Modality[]

  @@index([eventId])
  @@index([eventId, order])
}

model Modality {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId             String   @db.Uuid
  templateId          String?  @db.Uuid // Referência ao template (opcional)
  groupId             String?  @db.Uuid // Referência ao grupo (opcional)
  name                String
  description         String?
  price               Int // Preço em centavos
  maxParticipants     Int?
  currentParticipants Int      @default(0)
  isActive            Boolean  @default(true)
  order               Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  template      ModalityTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  group         ModalityGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  event         Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations RegistrationModality[]

  @@index([eventId])
  @@index([templateId])
  @@index([groupId])
  @@index([eventId, isActive])
}

model Kit {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event   Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items   KitItem[]
  tickets Ticket[]

  @@index([eventId])
}

model KitItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kitId       String   @db.Uuid
  productId   String?  @db.Uuid // Vinculação opcional a um produto
  name        String
  description String?
  sizes       Json // Array de objetos com {size: "G", stock: 100}
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kit           Kit                   @relation(fields: [kitId], references: [id], onDelete: Cascade)
  product       Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  registrations RegistrationKitItem[]

  @@index([kitId])
  @@index([productId])
}

model Registration {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String             @db.Uuid
  orderId       String             @db.Uuid
  userId        String?            @db.Uuid // null quando participante não tem conta
  status                RegistrationStatus @default(PENDING)
  qrCode                String?
  termsAccepted         Boolean            @default(false)
  rulesAccepted         Boolean            @default(false)
  emergencyContactName  String?
  emergencyContactPhone String?
  // Snapshot do participante convidado (preenchido quando userId = null)
  participantName       String?
  participantEmail      String?
  // Documento (legacy, ainda gravado em paralelo enquanto durar a compat):
  participantCpf        String?
  participantCpfClean   String?
  // Documento internacionalizado — fonte de verdade nova. *Clean normalizado
  // por cleanDocumentNumber() (depende de participantDocumentType).
  participantDocumentType        DocumentType?
  participantDocumentNumber      String?
  participantDocumentNumberClean String?
  participantPhone      String?
  participantDateOfBirth DateTime?
  participantGender     String?
  // Snapshot completo da compra no momento do pagamento — recibo imutável
  receiptSnapshot Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  event           Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order           Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User?                  @relation("Participant", fields: [userId], references: [id], onDelete: SetNull)
  invitedBy       User?                  @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById     String?                @db.Uuid
  modalities      RegistrationModality[]
  kitItems        RegistrationKitItem[]
  questionAnswers QuestionAnswer[]
  tickets         RegistrationTicket[]
  products        RegistrationProduct[]

  @@index([eventId])
  @@index([orderId])
  @@index([userId])
  @@index([invitedById])
  @@index([participantCpfClean])
  @@index([participantDocumentNumberClean])
  @@index([eventId, participantDocumentNumberClean])
  @@index([eventId, status])
  @@index([userId, createdAt])
  @@index([invitedById, createdAt])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model RegistrationModality {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId String   @db.Uuid
  modalityId     String   @db.Uuid
  createdAt      DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  modality     Modality     @relation(fields: [modalityId], references: [id], onDelete: Cascade)

  @@unique([registrationId, modalityId])
  @@index([registrationId])
  @@index([modalityId])
}

model RegistrationKitItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId String   @db.Uuid
  kitItemId      String   @db.Uuid
  selectedSize   String
  quantity       Int      @default(1)
  createdAt      DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  kitItem      KitItem      @relation(fields: [kitItemId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([kitItemId])
}

model Question {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String   @db.Uuid
  question    String
  description String?
  type        String   @default("text") // text, select, checkbox, radio
  options     Json? // Para tipos select, radio, checkbox
  appliesTo   String? // 'all' ou JSON array de ticket IDs
  isRequired  Boolean  @default(false)
  isActive    Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  event   Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers QuestionAnswer[]

  @@index([eventId])
  @@index([eventId, isActive])
}

model QuestionAnswer {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId   String   @db.Uuid
  questionId       String   @db.Uuid
  answer           String
  // Snapshot da pergunta no momento da resposta (texto, tipo, opções)
  questionSnapshot Json?
  createdAt        DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  question     Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([registrationId, questionId])
  @@index([registrationId])
  @@index([questionId])
}

model Order {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid // Usuário que fez o pedido (comprador)
  eventId     String   @db.Uuid // Evento ao qual o pedido pertence
  totalAmount Int // Valor total do pedido em centavos
  serviceFee  Int // Taxa de serviço total em centavos
  discount    Int      @default(0) // Desconto total (cupom/voucher) em centavos
  finalAmount Int // Valor final a pagar em centavos
  couponId        String?  @db.Uuid // Cupom aplicado no pedido
  voucherId       String?  @db.Uuid // Voucher aplicado no pedido
  idempotencyKey  String?  @unique  // Chave de idempotência para evitar pedidos duplicados
  /// Endereço de cobrança (checkout)
  billingCountry       String?
  billingPostalCode    String?
  billingStateUf       String?
  billingStreet        String?
  billingNumber        String?
  billingComplement    String?
  billingNeighborhood  String?
  billingCity          String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  status              OrderStatus @default(PENDING)
  expiresAt           DateTime?
  reservedAt          DateTime?
  cancelledAt         DateTime?
  cancelledReason     String?
  pendingParticipants Json?
  pendingProducts     Json?

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  event           Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  coupon          Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  voucher         Voucher?             @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  payment         Payment?
  registrations   Registration[]
  reservedTickets OrderReservedTicket[]

  @@index([userId])
  @@index([eventId])
  @@index([createdAt])
  @@index([eventId, createdAt]) // Janelas por data do pedido (métricas / relatórios)
  @@index([status, expiresAt])
  @@index([eventId, status, createdAt]) // Listagem fiscal (PAID por evento + ordenação por data)
}

model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String        @unique @db.Uuid // Um pagamento por pedido
  userId        String        @db.Uuid // Usuário que fez o pagamento
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Int // Valor em centavos
  transactionId String?
  paymentDate   DateTime?
  metadata      Json? // Dados adicionais do pagamento
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([transactionId])
  @@index([status, createdAt]) // Para relatórios de pagamento
  @@index([method, status]) // Para análise por método
}

model OrderReservedTicket {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String   @db.Uuid
  ticketId   String   @db.Uuid
  batchId    String   @db.Uuid
  quantity   Int
  unitPrice  Int
  batchName  String?
  ticketName String?
  createdAt  DateTime @default(now())

  order  Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticket Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  batch  TicketBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([ticketId])
  @@index([batchId])
}

model ContactMessage {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String?  @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  name           String
  email          String
  phone          String?
  message        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([eventId])
  @@index([isRead])
}

model LinkedUser {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mainUserId          String        @db.Uuid
  firstName           String
  lastName            String
  email               String?
  // documentType nullable durante a janela de compat. Após o backfill, todos
  // os registros antigos viram CPF; novos sempre informam o tipo via DTO.
  documentType        DocumentType?
  documentNumber      String?
  documentNumberClean String?
  phone               String?
  dateOfBirth         DateTime?
  gender              String?
  relationshipType    String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  mainUser User @relation("MainUser", fields: [mainUserId], references: [id], onDelete: Cascade)

  // Unique composta com tipo: evita colisão entre CPF 11-dígitos e passaporte
  // que coincidentemente normaliza pra 11 chars idênticos. O unique antigo
  // (mainUserId, documentNumberClean) é dropado pela migration A.
  @@unique([mainUserId, documentType, documentNumberClean])
  @@index([mainUserId])
  @@index([mainUserId, documentType])
}

model Coupon {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String             @db.Uuid
  code          String? // Obrigatório para DISCOUNT, opcional para QUANTITY e AGE
  couponType    CouponType
  type          CouponDiscountType
  value         Int // Valor em centavos (para FIXED) ou porcentagem (para PERCENTAGE)
  note          String?
  appliesTo     String? // 'all' ou ID de modalidade específica
  expiryDate    DateTime?
  minCartValue  Int? // Valor mínimo do carrinho em centavos
  cpfListStatus CpfListStatus      @default(DISABLED)
  cpfList       Json? // LEGACY — array de CPFs (clean, só dígitos). Mantido pra retrocompat.
  // Lista internacionalizada de documentos elegíveis. Shape:
  //   [{ type: 'CPF' | 'PASSPORT', numberClean: string }]
  // Fonte de verdade nova. cpfList é mantido em paralelo durante a transição
  // (fase E remove). Quando ambos estão presentes, o service prefere documentList.
  documentList  Json?
  minQuantity   Int? // Para couponType QUANTITY
  ageRule       String? // 'MIN' ou 'MAX' para couponType AGE
  ageValue      String? // Ex: '9 anos'
  minAge        Int? // Idade mínima em anos (restrição de faixa etária)
  maxAge        Int? // Idade máxima em anos (restrição de faixa etária)
  status        CouponStatus       @default(ACTIVE)
  usageCount    Int                @default(0)
  maxUsage      Int?               // Limite máximo de usos do cupom
  applyToProducts Boolean          @default(false) // Inclui produtos adicionais (kits/extras) na base de cálculo do desconto
  deletedAt     DateTime?          // Soft delete — cupom removido após uso
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([eventId, code])
  @@index([eventId])
  @@index([code])
  @@index([status])
  @@index([eventId, status])
  @@index([deletedAt])
}

model Voucher {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String        @db.Uuid
  name          String // Nome do lote de vouchers
  code          String        @unique // Código único gerado automaticamente
  appliesTo     String? // 'all' ou JSON array de ticket IDs
  expiryDate    DateTime?
  cpfListStatus CpfListStatus @default(DISABLED)
  cpfList       Json? // LEGACY — array de CPFs (clean). Mantido pra retrocompat.
  // Lista internacionalizada: [{ type, numberClean }]. Ver Coupon.documentList.
  documentList  Json?
  status          VoucherStatus @default(ACTIVE)
  applyToProducts Boolean       @default(false) // Espelha Coupon.applyToProducts: o ingresso grátis cobre também os produtos adicionais (kits/extras) do pedido
  usedAt          DateTime? // Data em que foi usado
  usedBy          String?       @db.Uuid // ID do usuário que usou
  deletedAt       DateTime? // Soft delete — grupo removido quando há vendas
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([eventId, code])
  @@index([eventId])
  @@index([code])
  @@index([status])
  @@index([eventId, status])
  @@index([deletedAt])
  @@index([code, status]) // Para busca rápida por código e status
}

model TicketCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @db.Uuid
  name        String
  description String?
  /// Ordem de exibição (0 = primeiro). Coluna no Postgres: "sortOrder" (ver migração rename).
  order       Int      @default(0) @map("sortOrder")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([eventId])
  @@index([eventId, order])
}

model Ticket {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String   @db.Uuid
  categoryId   String?  @db.Uuid
  /// Ordem de exibição dentro do mesmo evento e mesma categoria (ou entre sem categoria: categoryId null).
  sortOrder    Int      @default(0)
  name         String
  description  String?
  modality     String // Valor do template selecionado (ex: 'Corrida de rua')
  distance     String?
  distanceUnit String?  @default("KM")
  gender       String? // 'all', 'male', 'female'
  ageLimitMin  Int?
  ageLimitMax  Int?
  hasKit       Boolean  @default(false)
  kitId        String?  @db.Uuid
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event           Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category        TicketCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  kit             Kit?                 @relation(fields: [kitId], references: [id], onDelete: SetNull)
  batches         TicketBatch[]
  products        TicketProduct[]
  registrations   RegistrationTicket[]
  reservedTickets OrderReservedTicket[]

  @@index([eventId])
  @@index([categoryId])
  @@index([eventId, isActive])
  @@index([eventId, categoryId, sortOrder])
}

model TicketBatch {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId          String    @db.Uuid
  quantity          Int
  availableQuantity Int
  price             Int // Preço em centavos
  startDate         DateTime?
  endDate           DateTime?
  /// Ordem sequencial dentro do ticket (0 = primeiro lote).
  sortOrder         Int       @default(0)
  /// BY_TIME → ativa quando startDate é atingida. AFTER_PREVIOUS_SOLD_OUT → ativa quando o lote anterior vender tudo.
  triggerType       String    @default("BY_TIME")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ticket          Ticket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  registrations   RegistrationTicket[]
  reservedBatches OrderReservedTicket[]

  @@index([ticketId])
  @@index([ticketId, sortOrder])
  @@index([ticketId, startDate, endDate])
}

model Product {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String    @db.Uuid
  name               String
  image              String?
  images             String[]
  primaryImageIndex  Int       @default(0)
  isIncludedInTicket Boolean   @default(false)
  basePrice          Int       @default(0) // Preço base em centavos
  isRequired         Boolean   @default(false)
  variationType      String? // Tipo/nome da variação (ex: "Tamanhos", "Cores")
  /// Comprador pode alterar a variação escolhida após a compra, dentro da janela em dias antes do evento.
  buyerVariationEditAllowed Boolean @default(false)
  /// Dias corridos antes da data do evento até quando a alteração de variação é permitida; 0 quando não permitido.
  variationEditDeadlineDays Int     @default(0)
  deletedAt          DateTime? // Soft delete — produto removido pelo organizador
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  event         Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  variations    ProductVariation[]
  tickets       TicketProduct[]
  kitItems      KitItem[]
  registrations RegistrationProduct[]

  @@index([eventId])
}

model ProductVariation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @db.Uuid
  name      String
  price     Int // Preço em centavos
  stock     Int      @default(0) // 0 = ilimitado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  registrations RegistrationProduct[]

  @@index([productId])
}

model TicketProduct {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId   String   @db.Uuid
  productId  String   @db.Uuid
  /// Ordem de exibição por ingresso (0 = primeiro). Mesmo produto em tickets diferentes tem ordens independentes.
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([ticketId, productId])
  @@index([ticketId])
  @@index([ticketId, sortOrder])
  @@index([productId])
}

model RegistrationTicket {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId String   @db.Uuid
  ticketId       String   @db.Uuid
  batchId        String?  @db.Uuid
  // Snapshot completo do ingresso no momento da compra (preservado mesmo após edições/deleção)
  ticketSnapshot Json?
  createdAt      DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  batch        TicketBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([registrationId, ticketId])
  @@index([registrationId])
  @@index([ticketId])
  @@index([batchId])
}

model RegistrationProduct {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId  String   @db.Uuid
  productId       String   @db.Uuid
  variationId     String?  @db.Uuid // Variação escolhida (opcional, se o produto tiver variações)
  variationEdited Boolean  @default(false) // true após o comprador alterar a variação (permitido apenas uma vez)
  quantity        Int      @default(1)
  unitPrice       Int // Preço unitário em centavos no momento da compra
  totalPrice      Int // Preço total em centavos (unitPrice * quantity)
  // Snapshot do produto no momento da compra — preservado mesmo após edições ou soft delete
  productSnapshot Json?
  createdAt       DateTime @default(now())

  registration Registration      @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variation    ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([productId])
  @@index([variationId])
}

// ─── Repasse / Saque ────────────────────────────────────────────────────────

model EventWithdrawal {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String           @db.Uuid
  requestedById String           @db.Uuid
  /// Valor bruto solicitado pelo organizador (centavos)
  amount        Int
  /// Snapshot da taxa Podio no momento do saque (ex: 0.04)
  feeRate       Float
  /// Valor da taxa Podio (centavos)
  feeAmount     Int
  /// Valor líquido recebido pelo organizador (centavos)
  netAmount     Int
  status        WithdrawalStatus @default(PENDING)
  notes         String?
  /// URL do documento de extrato/comprovante vinculado pelo admin
  receiptUrl    String?
  /// Chave PIX da organização escolhida no momento do saque.
  /// SetNull preserva o histórico se a chave for excluída — o snapshot fica intacto.
  pixKeyId      String?          @db.Uuid
  /// Snapshot dos dados da chave PIX no momento do saque (key, keyType, bankName,
  /// accountHolderName, accountHolderDocument). Fonte de verdade para o admin pagar —
  /// nunca confiar na OrganizationPixKey atual, que pode ter sido editada/excluída.
  pixKeySnapshot Json?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requestedBy User                @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  pixKey      OrganizationPixKey? @relation(fields: [pixKeyId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([eventId, status])
  @@index([eventId, createdAt])
  @@index([pixKeyId])
}

model EventAudit {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String   @unique @db.Uuid
  auditedById       String   @db.Uuid
  /// Valor dos 10% (ou última parcela) liberados pela auditoria (centavos)
  retentionReleased Int
  notes             String?
  createdAt         DateTime @default(now())

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  auditedBy User  @relation(fields: [auditedById], references: [id], onDelete: Cascade)
}

/// Log granular de atividade de usuário (participante + organizador + anônimo).
/// Insert-only; gravado em batch via UserActivityService. Cron de retenção
/// apaga linhas conforme a categoria (analytics 90d / auditoria 2 anos).
///
/// userId pode ser null em duas situações legítimas:
///  - visita anônima (pré-login) — `sessionId` costura a jornada.
///  - usuário excluído via direito LGPD — relação cai pra null (SetNull).
model UserActivityLog {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?              @db.Uuid
  /// ID gerado pelo frontend (UUID em localStorage) para costurar pré→pós login.
  sessionId  String?              @db.VarChar(64)
  ip         String?
  userAgent  String?
  source     UserActivitySource
  category   UserActivityCategory
  /// Identificador curto da ação. Ex.: "page:event/:slug", "click:btn-buy", "api:POST /orders/reserve".
  action     String
  path       String?
  referrer   String?
  /// Payload livre. Sanitizado antes do insert (chaves PII removidas).
  metadata   Json?
  occurredAt DateTime             @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([category, occurredAt])
  /// Usado pelo cron de retenção (DELETE WHERE occurredAt < N).
  @@index([occurredAt])
}
